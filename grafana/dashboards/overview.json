      },
      "targets": [
        {
          "rawSql": "SELECT key AS \"Tool\", sum((value->>'calls')::int) AS \"Calls\", sum((value->>'errors')::int) AS \"Errors\", CASE WHEN sum((value->>'calls')::int) > 0 THEN round(sum((value->>'errors')::int)::numeric / sum((value->>'calls')::int) * 100, 1) ELSE 0 END AS \"Error %\", CASE WHEN sum((value->>'calls')::int) > 0 THEN round(sum((value->>'avg_ms')::bigint * (value->>'calls')::int)::numeric / sum((value->>'calls')::int), 0) ELSE 0 END AS \"Avg ms\" FROM telemetry, jsonb_each(payload->'tools') WHERE jsonb_typeof(payload->'tools') = 'object' AND (value->>'calls')::int > 0 AND ('$exclude_prod' = '0' OR instance_id NOT LIKE '997b38cd%') GROUP BY key ORDER BY \"Calls\" DESC",
