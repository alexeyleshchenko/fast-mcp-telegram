      "targets": [
        {
          "rawSql": "SELECT tool_key AS \"Tool\", param_key AS \"Paramset\", SUM((param_value->>'calls')::int) AS \"Calls\", SUM((param_value->>'errors')::int) AS \"Errors\", CASE WHEN SUM((param_value->>'calls')::int) > 0 THEN ROUND(SUM((param_value->>'errors')::numeric) / SUM((param_value->>'calls')::int) * 100, 1) ELSE 0 END AS \"Error %\", CASE WHEN SUM((param_value->>'calls')::int) > 0 THEN ROUND(SUM((param_value->>'duration_ms')::float) / SUM((param_value->>'calls')::int))::int ELSE 0 END AS \"Avg ms\" FROM telemetry, jsonb_each(payload->'tools') AS t(tool_key, tool_value), jsonb_each(tool_value->'param_sets') AS p(param_key, param_value) WHERE jsonb_typeof(payload->'tools') = 'object' AND jsonb_typeof(tool_value->'param_sets') = 'object' AND ('$exclude_prod' = '0' OR instance_id NOT LIKE '997b38cd%') AND payload->>'ver' >= '0.33.0' GROUP BY tool_key, param_key ORDER BY tool_key, \"Calls\" DESC",
          "format": "table",
          "refId": "A"
