      "targets": [
        {
          "rawSql": "WITH latest AS (SELECT DISTINCT ON (instance_id) instance_id, payload->'features' AS features FROM telemetry WHERE ('$exclude_prod' = '0' OR instance_id NOT LIKE '997b38cd%') ORDER BY instance_id, received_at DESC) SELECT feature AS \"Feature\", count(*) FILTER (WHERE enabled) AS \"Enabled\", count(*) AS \"Total\" FROM latest, LATERAL (VALUES ('block_private_ips', (features->>'block_private_ips')::boolean), ('acl_enabled', (features->>'acl_enabled')::boolean), ('bot_api_token', (features->>'bot_api_token')::boolean), ('mtproto_proxy', (features->>'mtproto_proxy')::boolean), ('allow_http_urls', (features->>'allow_http_urls')::boolean), ('prefix_mcp_tools_with_account', (features->>'prefix_mcp_tools_with_account')::boolean)) AS t(feature, enabled) GROUP BY feature ORDER BY \"Enabled\" DESC",
          "format": "table",
          "refId": "A"
        }
